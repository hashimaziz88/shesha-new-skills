{
  "_meta": {
    "description": "Per-component default values to merge in when authoring new components directly in JSON. Mirrors the MCP xml_to_json_transformer defaults so direct-JSON authoring produces the same minimally-valid components.",
    "usage": "Look up by component type. Merge defaults BEFORE the user-specified overrides so the user's values win on conflict."
  },

  "_base": {
    "_comment": "Applied to every component regardless of type.",
    "hidden": false,
    "isDynamic": false,
    "version": "1",
    "editMode": "inherited"
  },

  "_formSettings": {
    "_comment": "Defaults for new forms.",
    "access": null,
    "permissions": null,
    "version": 7,
    "dataLoaderType": "gql",
    "dataSubmitterType": "gql",
    "onBeforeDataLoad": "    form.setFieldsValue({...form.formArguments});",
    "dataSubmittersSettings": {
      "gql": {
        "endpointType": "default",
        "dynamicEndpoint": "    return data?.id ? form.defaultApiEndpoints.update : form.defaultApiEndpoints.create"
      }
    },
    "dataLoadersSettings": { "gql": { "endpointType": "default" }, "custom": {} },
    "labelCol": { "span": 8 },
    "wrapperCol": { "span": 16 },
    "layout": "horizontal"
  },

  "textField": { "textType": "text", "editMode": "editable" },
  "textArea":  { "editMode": "editable" },
  "numberField": { "editMode": "editable" },
  "dropdown":  { "mode": "single", "dataSourceType": "referenceList", "valueFormat": "simple", "editMode": "editable" },
  "checkboxGroup": { "dataSourceType": "referenceList", "direction": "vertical", "editMode": "editable" },
  "radio":     { "dataSourceType": "referenceList", "direction": "vertical", "editMode": "editable" },
  "dateField": { "picker": "date", "dateFormat": "DD/MM/YYYY", "showTime": false, "editMode": "editable" },
  "timePicker":{ "format": "HH:mm", "use12Hours": false, "editMode": "editable" },
  "checkbox":  { "defaultValue": false, "editMode": "editable" },
  "switch":    { "defaultValue": false, "editMode": "editable" },
  "rate":      { "count": 5, "editMode": "editable" },
  "slider":    { "min": 0, "max": 100, "step": 1, "editMode": "editable" },
  "colorPicker": { "format": "hex", "showText": false, "editMode": "editable" },
  "richTextEditor": { "mode": "html", "editMode": "editable" },

  "text":      { "textType": "span" },
  "alert":     { "text": "Alert Message", "alertType": "info", "showIcon": true },
  "link":      { "target": "_self", "editMode": "editable" },
  "icon":      {},
  "image":     {},
  "statistic": {},
  "progress":  {},
  "validationErrors": {},

  "address": {
    "googleMapsApiKey": "",
    "openCageApiKey": "",
    "countryRestriction": [],
    "prefix": "",
    "showPriorityBounds": false,
    "editMode": "editable"
  },
  "fileUpload": {
    "allowReplace": true,
    "allowDelete": true,
    "allowUpload": true,
    "isDragger": false,
    "useSync": false,
    "editMode": "editable"
  },
  "notes": { "editMode": "editable" },

  "autocomplete": {
    "mode": "single",
    "valueFormat": "simple",
    "dataSourceType": "entitiesList",
    "editMode": "editable"
  },
  "entitySelector": {
    "displayProperty": "fullName",
    "valueProperty": "id",
    "multiSelect": false,
    "placeholder": "Search and select...",
    "editMode": "editable"
  },
  "entityPicker": {
    "mode": "single",
    "editMode": "editable"
  },
  "refListStatus": {
    "hideLabel": true,
    "showIcon": true
  },

  "sectionSeparator": { "orientation": "left", "dashed": false },
  "wizard": { "current": 0, "direction": "horizontal" },
  "tabs":   { "tabType": "line", "tabPosition": "top" },
  "tab":    { "editMode": "inherited", "selectMode": "editable" },
  "columns":{ "gutterX": 12, "gutterY": 12 },
  "column": { "flex": 12, "offset": 0, "push": 0, "pull": 0 },
  "container": { "direction": "vertical" },

  "collapsiblePanel": {
    "expandIconPosition": "start",
    "header": { "components": [] },
    "content": { "components": [] }
  },
  "card": {
    "header": { "components": [] },
    "content": { "components": [] }
  },

  "datatable": {
    "useMultiSelect": false,
    "freezeHeaders": false,
    "canEditInline": "no",
    "canAddInline": "no",
    "canDeleteInline": "no"
  },
  "datatableContext": {
    "sourceType": "Entity",
    "defaultPageSize": 10,
    "dataFetchingMode": "paging"
  },
  "dataList": { "pageSize": 10 },
  "kanban":   { "groupProperty": "status" },
  "tree":     { "titleProperty": "name", "checkable": false },
  "tableViewSelector": {},

  "button": { "editMode": "editable" },
  "buttonGroup": {},
  "buttonGroupItem": { "editMode": "editable" },

  "subForm": {
    "dataSource": "api",
    "apiMode": "entityName",
    "formSelectionMode": "name",
    "hideLabel": true,
    "labelCol": 6,
    "wrapperCol": 18
  },

  "keyInformationBar": {
    "label": "",
    "hideLabel": true
  }
}
