{
  "_template": {
    "kind": "reports-printable",
    "version": 1,
    "placeholders": ["__MODULE__", "__ENTITY__", "__ENTITY_KEBAB__", "__ENTITY_PRETTY__", "__MODEL_TYPE__"],
    "slots": {},
    "invariants": [
      "Print layout — fixed-width A4-ish container, generous margins, single column.",
      "Includes a print toolbar (visible on screen, hidden in print via @media print on a host stylesheet — see references/cheatsheet.md §18).",
      "Footer + signature block always visible; auditors require it."
    ]
  },
  "components": [
    {
      "id": "tpl-rep-root",
      "type": "container",
      "propertyName": "reportRoot",
      "componentName": "reportRoot",
      "parentId": "root",
      "className": "sha-page",
      "direction": "vertical",
      "label": " ",
      "hideLabel": true,
      "components": [
        {
          "id": "tpl-rep-toolbar",
          "type": "container",
          "propertyName": "printToolbar",
          "componentName": "printToolbar",
          "parentId": "tpl-rep-root",
          "direction": "horizontal",
          "justifyContent": "flex-end",
          "alignItems": "center",
          "label": " ",
          "hideLabel": true,
          "components": [
            {
              "id": "tpl-rep-btn-print",
              "type": "button",
              "propertyName": "btnPrint",
              "componentName": "btnPrint",
              "parentId": "tpl-rep-toolbar",
              "label": "Print",
              "buttonType": "primary",
              "icon": "PrinterOutlined",
              "editMode": "editable",
              "actionConfiguration": {
                "actionOwner": "shesha.common",
                "actionName": "Execute Script",
                "handleSuccess": false,
                "handleFail": false,
                "actionArguments": { "expression": "window.print();" }
              }
            },
            {
              "id": "tpl-rep-btn-pdf",
              "type": "button",
              "propertyName": "btnPdf",
              "componentName": "btnPdf",
              "parentId": "tpl-rep-toolbar",
              "label": "Download PDF",
              "buttonType": "secondary",
              "icon": "FilePdfOutlined",
              "editMode": "editable",
              "actionConfiguration": {
                "actionOwner": "shesha.common",
                "actionName": "Execute Script",
                "handleSuccess": false,
                "handleFail": false,
                "actionArguments": { "expression": "message.info('TODO: wire PDF export endpoint');" }
              }
            }
          ]
        },
        {
          "id": "tpl-rep-sheet",
          "type": "container",
          "propertyName": "reportSheet",
          "componentName": "reportSheet",
          "parentId": "tpl-rep-root",
          "direction": "vertical",
          "label": " ",
          "hideLabel": true,
          "components": [
            {
              "id": "tpl-rep-header",
              "type": "container",
              "propertyName": "reportHeader",
              "componentName": "reportHeader",
              "parentId": "tpl-rep-sheet",
              "direction": "horizontal",
              "justifyContent": "space-between",
              "alignItems": "center",
              "label": " ",
              "hideLabel": true,
              "components": [
                {
                  "id": "tpl-rep-logo",
                  "type": "image",
                  "propertyName": "orgLogo",
                  "componentName": "orgLogo",
                  "parentId": "tpl-rep-header",
                  "label": " ",
                  "hideLabel": true,
                  "dataSource": "url",
                  "url": "/images/logo.png",
                  "height": "48px",
                  "objectFit": "contain",
                  "objectPosition": "left"
                },
                {
                  "id": "tpl-rep-meta",
                  "type": "container",
                  "propertyName": "reportMeta",
                  "componentName": "reportMeta",
                  "parentId": "tpl-rep-header",
                  "direction": "vertical",
                  "label": " ",
                  "hideLabel": true,
                  "components": [
                    {
                      "id": "tpl-rep-meta-date",
                      "type": "text",
                      "propertyName": "metaDate",
                      "componentName": "metaDate",
                      "parentId": "tpl-rep-meta",
                      "label": " ",
                      "hideLabel": true,
                      "content": "Generated: {{new Date().toLocaleString('en-ZA')}}",
                      "contentDisplay": "content",
                      "textType": "span"
                    },
                    {
                      "id": "tpl-rep-meta-id",
                      "type": "text",
                      "propertyName": "metaId",
                      "componentName": "metaId",
                      "parentId": "tpl-rep-meta",
                      "label": " ",
                      "hideLabel": true,
                      "content": "Document ID: {{data?.id || 'DRAFT'}}",
                      "contentDisplay": "content",
                      "textType": "span"
                    }
                  ]
                }
              ]
            },
            {
              "id": "tpl-rep-title",
              "type": "text",
              "propertyName": "reportTitle",
              "componentName": "reportTitle",
              "parentId": "tpl-rep-sheet",
              "label": " ",
              "hideLabel": true,
              "content": "__ENTITY_PRETTY__ Report",
              "contentDisplay": "content",
              "level": 1,
              "textType": "span"
            },
            {
              "id": "tpl-rep-subtitle",
              "type": "text",
              "propertyName": "reportSubtitle",
              "componentName": "reportSubtitle",
              "parentId": "tpl-rep-sheet",
              "label": " ",
              "hideLabel": true,
              "content": "Period: {{data?.startDate || '—'}} to {{data?.endDate || '—'}}",
              "contentDisplay": "content",
              "textType": "span"
            },
            {
              "id": "tpl-rep-section-summary",
              "type": "sectionSeparator",
              "propertyName": "sectionSummary",
              "componentName": "sectionSummary",
              "parentId": "tpl-rep-sheet",
              "label": "Summary"
            },
            {
              "id": "tpl-rep-summary",
              "type": "container",
              "propertyName": "summaryContent",
              "componentName": "summaryContent",
              "parentId": "tpl-rep-sheet",
              "direction": "vertical",
              "label": " ",
              "hideLabel": true,
              "components": [
                {
                  "id": "tpl-rep-summary-text",
                  "type": "text",
                  "propertyName": "summaryText",
                  "componentName": "summaryText",
                  "parentId": "tpl-rep-summary",
                  "label": " ",
                  "hideLabel": true,
                  "content": "This report summarises activity for the period above. Replace this paragraph with executive-summary copy when generating the report.",
                  "contentDisplay": "content",
                  "textType": "span"
                }
              ]
            },
            {
              "id": "tpl-rep-section-detail",
              "type": "sectionSeparator",
              "propertyName": "sectionDetail",
              "componentName": "sectionDetail",
              "parentId": "tpl-rep-sheet",
              "label": "Detail"
            },
            {
              "id": "tpl-rep-detail-ctx",
              "type": "datatableContext",
              "propertyName": "detailContext",
              "componentName": "detailContext",
              "parentId": "tpl-rep-sheet",
              "label": " ",
              "hideLabel": true,
              "sourceType": "Entity",
              "entityType": "__MODEL_TYPE__",
              "dataFetchingMode": "fetchAll",
              "components": [
                {
                  "id": "tpl-rep-detail-table",
                  "type": "datatable",
                  "propertyName": "detailTable",
                  "componentName": "detailTable",
                  "parentId": "tpl-rep-detail-ctx",
                  "label": " ",
                  "hideLabel": true,
                  "rowDividers": true,
                  "freezeHeaders": false,
                  "items": [
                    { "id": "tpl-rep-col-ref",  "columnType": "data", "propertyName": "_displayName", "caption": "Reference", "isVisible": true, "minWidth": 200 },
                    { "id": "tpl-rep-col-time", "columnType": "data", "propertyName": "creationTime", "caption": "Created",   "isVisible": true, "minWidth": 160 }
                  ]
                }
              ]
            },
            {
              "id": "tpl-rep-section-sign",
              "type": "sectionSeparator",
              "propertyName": "sectionSign",
              "componentName": "sectionSign",
              "parentId": "tpl-rep-sheet",
              "label": "Approval"
            },
            {
              "id": "tpl-rep-sign-row",
              "type": "columns",
              "propertyName": "signatureRow",
              "componentName": "signatureRow",
              "parentId": "tpl-rep-sheet",
              "label": " ",
              "hideLabel": true,
              "gutterX": 32,
              "gutterY": 16,
              "columns": [
                {
                  "id": "tpl-rep-sign-prepared",
                  "flex": 8, "offset": 0, "push": 0, "pull": 0,
                  "components": [
                    { "id": "tpl-rep-sign-prep-line", "type": "text", "propertyName": "preparedLine", "componentName": "preparedLine", "parentId": "tpl-rep-sign-prepared", "label": " ", "hideLabel": true, "content": "_________________________", "contentDisplay": "content", "textType": "span" },
                    { "id": "tpl-rep-sign-prep-label", "type": "text", "propertyName": "preparedLabel", "componentName": "preparedLabel", "parentId": "tpl-rep-sign-prepared", "label": " ", "hideLabel": true, "content": "Prepared by", "contentDisplay": "content", "textType": "span" }
                  ]
                },
                {
                  "id": "tpl-rep-sign-reviewed",
                  "flex": 8, "offset": 0, "push": 0, "pull": 0,
                  "components": [
                    { "id": "tpl-rep-sign-rev-line", "type": "text", "propertyName": "reviewedLine", "componentName": "reviewedLine", "parentId": "tpl-rep-sign-reviewed", "label": " ", "hideLabel": true, "content": "_________________________", "contentDisplay": "content", "textType": "span" },
                    { "id": "tpl-rep-sign-rev-label", "type": "text", "propertyName": "reviewedLabel", "componentName": "reviewedLabel", "parentId": "tpl-rep-sign-reviewed", "label": " ", "hideLabel": true, "content": "Reviewed by", "contentDisplay": "content", "textType": "span" }
                  ]
                },
                {
                  "id": "tpl-rep-sign-approved",
                  "flex": 8, "offset": 0, "push": 0, "pull": 0,
                  "components": [
                    { "id": "tpl-rep-sign-app-line", "type": "text", "propertyName": "approvedLine", "componentName": "approvedLine", "parentId": "tpl-rep-sign-approved", "label": " ", "hideLabel": true, "content": "_________________________", "contentDisplay": "content", "textType": "span" },
                    { "id": "tpl-rep-sign-app-label", "type": "text", "propertyName": "approvedLabel", "componentName": "approvedLabel", "parentId": "tpl-rep-sign-approved", "label": " ", "hideLabel": true, "content": "Approved by", "contentDisplay": "content", "textType": "span" }
                  ]
                }
              ]
            },
            {
              "id": "tpl-rep-footer",
              "type": "text",
              "propertyName": "reportFooter",
              "componentName": "reportFooter",
              "parentId": "tpl-rep-sheet",
              "label": " ",
              "hideLabel": true,
              "content": "Confidential. For authorised use only. Page __PAGE__ of __PAGES__.",
              "contentDisplay": "content",
              "textType": "span"
            }
          ]
        }
      ]
    }
  ],
  "formSettings": {
    "modelType": "__MODEL_TYPE__",
    "dataLoaderType": "none",
    "dataSubmitterType": "none",
    "dataLoadersSettings": { "gql": { "endpointType": "default" } },
    "dataSubmittersSettings": { "gql": { "endpointType": "default" } },
    "layout": "vertical",
    "labelCol": { "span": 0 },
    "wrapperCol": { "span": 24 },
    "colon": false,
    "size": "middle",
    "access": 3,
    "permissions": [],
    "version": 8,
    "_formFields": ["layout", "colon", "labelCol.span", "wrapperCol.span"]
  }
}
