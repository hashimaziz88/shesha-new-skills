{
  "_template": {
    "kind": "document-submission",
    "version": 1,
    "placeholders": ["__MODULE__", "__ENTITY__", "__ENTITY_KEBAB__", "__ENTITY_PRETTY__", "__MODEL_TYPE__"],
    "slots": {},
    "invariants": [
      "Each required document is its own card with: name, status badge (StoredFile.status reference list), upload button, view button, notes.",
      "The Submit-for-Review action POSTs to a SubmitDocuments endpoint — TODO: caller wires the actual URL.",
      "Documents are tracked as StoredFile entities (Shesha core); the parent __ENTITY__ holds them via ownerType+ownerId."
    ]
  },
  "components": [
    {
      "id": "tpl-docs-root",
      "type": "container",
      "propertyName": "docsRoot",
      "componentName": "docsRoot",
      "parentId": "root",
      "className": "sha-page",
      "direction": "vertical",
      "label": " ",
      "hideLabel": true,
      "components": [
        {
          "id": "tpl-docs-title",
          "type": "container",
          "propertyName": "docsTitle",
          "componentName": "docsTitle",
          "parentId": "tpl-docs-root",
          "className": "sha-page-title",
          "direction": "horizontal",
          "justifyContent": "space-between",
          "alignItems": "center",
          "label": " ",
          "hideLabel": true,
          "components": [
            {
              "id": "tpl-docs-heading-group",
              "type": "container",
              "propertyName": "headingGroup",
              "componentName": "headingGroup",
              "parentId": "tpl-docs-title",
              "direction": "vertical",
              "label": " ",
              "hideLabel": true,
              "components": [
                {
                  "id": "tpl-docs-h",
                  "type": "text",
                  "propertyName": "heading",
                  "componentName": "heading",
                  "parentId": "tpl-docs-heading-group",
                  "label": " ",
                  "hideLabel": true,
                  "content": "Required documents",
                  "contentDisplay": "content",
                  "level": 1,
                  "textType": "span"
                },
                {
                  "id": "tpl-docs-sub",
                  "type": "text",
                  "propertyName": "subtitle",
                  "componentName": "subtitle",
                  "parentId": "tpl-docs-heading-group",
                  "label": " ",
                  "hideLabel": true,
                  "content": "Upload each document. Once all required documents are verified, you can submit for review.",
                  "contentDisplay": "content",
                  "textType": "span"
                }
              ]
            },
            {
              "id": "tpl-docs-submit",
              "type": "button",
              "propertyName": "btnSubmit",
              "componentName": "btnSubmit",
              "parentId": "tpl-docs-title",
              "label": "Submit for review",
              "buttonType": "primary",
              "icon": "SendOutlined",
              "editMode": "editable",
              "actionConfiguration": {
                "actionOwner": "shesha.common",
                "actionName": "API Call",
                "handleSuccess": true,
                "handleFail": true,
                "actionArguments": {
                  "url": "/api/services/app/__ENTITY__/SubmitDocuments",
                  "verb": "POST",
                  "data": { "id": "{{data.id}}" }
                },
                "onSuccess": {
                  "_type": "action-config",
                  "actionOwner": "shesha.common",
                  "actionName": "Execute Script",
                  "actionArguments": { "expression": "message.success('Documents submitted for review.'); form.refresh();" }
                },
                "onFail": {
                  "_type": "action-config",
                  "actionOwner": "shesha.common",
                  "actionName": "Execute Script",
                  "actionArguments": { "expression": "if (actionError?.response) { message.error(actionError.response.data.error.message, 5); }" }
                }
              }
            }
          ]
        },
        {
          "id": "tpl-docs-content",
          "type": "container",
          "propertyName": "docsContent",
          "componentName": "docsContent",
          "parentId": "tpl-docs-root",
          "className": "sha-page-content",
          "direction": "vertical",
          "label": " ",
          "hideLabel": true,
          "components": [
            {
              "id": "tpl-docs-validation",
              "type": "validationErrors",
              "propertyName": "validationErrors",
              "componentName": "validationErrors",
              "parentId": "tpl-docs-content",
              "label": " ",
              "hideLabel": true
            },
            {
              "id": "tpl-docs-help",
              "type": "alert",
              "propertyName": "docsHelp",
              "componentName": "docsHelp",
              "parentId": "tpl-docs-content",
              "label": " ",
              "hideLabel": true,
              "alertType": "info",
              "text": "Accepted file formats: PDF, JPG, PNG. Maximum file size: 10 MB per document.",
              "showIcon": true
            },
            {
              "id": "tpl-docs-list",
              "type": "container",
              "propertyName": "documentsList",
              "componentName": "documentsList",
              "parentId": "tpl-docs-content",
              "direction": "vertical",
              "label": " ",
              "hideLabel": true,
              "components": [
                {
                  "id": "tpl-docs-card-1",
                  "type": "card",
                  "propertyName": "docIdProof",
                  "componentName": "docIdProof",
                  "parentId": "tpl-docs-list",
                  "label": "Proof of identity",
                  "hideLabel": false,
                  "header": { "id": "tpl-docs-card-1-h", "components": [] },
                  "content": {
                    "id": "tpl-docs-card-1-c",
                    "components": [
                      {
                        "id": "tpl-docs-card-1-row",
                        "type": "columns",
                        "propertyName": "row",
                        "componentName": "row",
                        "parentId": "tpl-docs-card-1-c",
                        "label": " ",
                        "hideLabel": true,
                        "gutterX": 16,
                        "gutterY": 8,
                        "columns": [
                          { "id": "tpl-docs-card-1-info", "flex": 16, "offset": 0, "push": 0, "pull": 0, "components": [
                            { "id": "tpl-docs-card-1-name", "type": "text", "propertyName": "name", "componentName": "name", "parentId": "tpl-docs-card-1-info", "label": " ", "hideLabel": true, "content": "Government-issued ID (passport, driver's licence, or national ID)", "contentDisplay": "content", "textType": "span" },
                            { "id": "tpl-docs-card-1-status", "type": "text", "propertyName": "status", "componentName": "status", "parentId": "tpl-docs-card-1-info", "label": " ", "hideLabel": true, "content": "Required", "contentDisplay": "content", "textType": "span", "font": { "size": 12, "color": "#D97706", "weight": "600" } }
                          ]},
                          { "id": "tpl-docs-card-1-actions", "flex": 8, "offset": 0, "push": 0, "pull": 0, "components": [
                            { "id": "tpl-docs-card-1-upload", "type": "fileUpload", "propertyName": "idProofFile", "componentName": "idProofFile", "parentId": "tpl-docs-card-1-actions", "label": " ", "hideLabel": true, "editMode": "editable", "allowUpload": true, "allowReplace": true, "allowDelete": true, "isDragger": false, "useSync": false, "ownerType": "__MODEL_TYPE__", "ownerIdExpression": "data?.id", "category": "idProof" }
                          ]}
                        ]
                      }
                    ]
                  }
                },
                {
                  "id": "tpl-docs-card-2",
                  "type": "card",
                  "propertyName": "docAddressProof",
                  "componentName": "docAddressProof",
                  "parentId": "tpl-docs-list",
                  "label": "Proof of address",
                  "hideLabel": false,
                  "header": { "id": "tpl-docs-card-2-h", "components": [] },
                  "content": {
                    "id": "tpl-docs-card-2-c",
                    "components": [
                      {
                        "id": "tpl-docs-card-2-row",
                        "type": "columns",
                        "propertyName": "row",
                        "componentName": "row",
                        "parentId": "tpl-docs-card-2-c",
                        "label": " ",
                        "hideLabel": true,
                        "gutterX": 16,
                        "gutterY": 8,
                        "columns": [
                          { "id": "tpl-docs-card-2-info", "flex": 16, "offset": 0, "push": 0, "pull": 0, "components": [
                            { "id": "tpl-docs-card-2-name", "type": "text", "propertyName": "name", "componentName": "name", "parentId": "tpl-docs-card-2-info", "label": " ", "hideLabel": true, "content": "Utility bill or bank statement (not older than 3 months)", "contentDisplay": "content", "textType": "span" },
                            { "id": "tpl-docs-card-2-status", "type": "text", "propertyName": "status", "componentName": "status", "parentId": "tpl-docs-card-2-info", "label": " ", "hideLabel": true, "content": "Required", "contentDisplay": "content", "textType": "span", "font": { "size": 12, "color": "#D97706", "weight": "600" } }
                          ]},
                          { "id": "tpl-docs-card-2-actions", "flex": 8, "offset": 0, "push": 0, "pull": 0, "components": [
                            { "id": "tpl-docs-card-2-upload", "type": "fileUpload", "propertyName": "addressProofFile", "componentName": "addressProofFile", "parentId": "tpl-docs-card-2-actions", "label": " ", "hideLabel": true, "editMode": "editable", "allowUpload": true, "allowReplace": true, "allowDelete": true, "isDragger": false, "useSync": false, "ownerType": "__MODEL_TYPE__", "ownerIdExpression": "data?.id", "category": "addressProof" }
                          ]}
                        ]
                      }
                    ]
                  }
                },
                {
                  "id": "tpl-docs-card-3",
                  "type": "card",
                  "propertyName": "docSupporting",
                  "componentName": "docSupporting",
                  "parentId": "tpl-docs-list",
                  "label": "Supporting documents",
                  "hideLabel": false,
                  "header": { "id": "tpl-docs-card-3-h", "components": [] },
                  "content": {
                    "id": "tpl-docs-card-3-c",
                    "components": [
                      {
                        "id": "tpl-docs-card-3-row",
                        "type": "columns",
                        "propertyName": "row",
                        "componentName": "row",
                        "parentId": "tpl-docs-card-3-c",
                        "label": " ",
                        "hideLabel": true,
                        "gutterX": 16,
                        "gutterY": 8,
                        "columns": [
                          { "id": "tpl-docs-card-3-info", "flex": 16, "offset": 0, "push": 0, "pull": 0, "components": [
                            { "id": "tpl-docs-card-3-name", "type": "text", "propertyName": "name", "componentName": "name", "parentId": "tpl-docs-card-3-info", "label": " ", "hideLabel": true, "content": "Any additional documents that support your application", "contentDisplay": "content", "textType": "span" },
                            { "id": "tpl-docs-card-3-status", "type": "text", "propertyName": "status", "componentName": "status", "parentId": "tpl-docs-card-3-info", "label": " ", "hideLabel": true, "content": "Optional", "contentDisplay": "content", "textType": "span", "font": { "size": 12, "color": "#525252", "weight": "500" } }
                          ]},
                          { "id": "tpl-docs-card-3-actions", "flex": 8, "offset": 0, "push": 0, "pull": 0, "components": [
                            { "id": "tpl-docs-card-3-upload", "type": "attachmentsEditor", "propertyName": "supportingDocuments", "componentName": "supportingDocuments", "parentId": "tpl-docs-card-3-actions", "label": " ", "hideLabel": true, "editMode": "editable", "allowUpload": true, "allowReplace": true, "allowDelete": true, "isDragger": true, "ownerType": "__MODEL_TYPE__", "ownerIdExpression": "data?.id", "category": "supporting" }
                          ]}
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "formSettings": {
    "modelType": "__MODEL_TYPE__",
    "dataLoaderType": "gql",
    "dataSubmitterType": "gql",
    "dataLoadersSettings": { "gql": { "endpointType": "default" } },
    "dataSubmittersSettings": { "gql": { "endpointType": "default" } },
    "layout": "vertical",
    "labelCol": { "span": 0 },
    "wrapperCol": { "span": 24 },
    "colon": false,
    "size": "middle",
    "access": 3,
    "permissions": [],
    "version": 8,
    "_formFields": ["layout", "colon", "labelCol.span", "wrapperCol.span"]
  }
}
