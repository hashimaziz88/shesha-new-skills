{
  "components": [
    {
      "id": "root-container",
      "type": "container",
      "propertyName": "root",
      "label": "",
      "hidden": false,
      "components": [
        {
          "id": "header-row",
          "type": "columns",
          "propertyName": "headerRow",
          "label": "",
          "columns": [
            {
              "id": "col-title",
              "flex": 1,
              "components": [
                {
                  "id": "page-title",
                  "type": "text",
                  "propertyName": "pageTitle",
                  "content": "Interviews",
                  "fontSize": 24,
                  "fontWeight": "bold"
                }
              ]
            },
            {
              "id": "col-btn",
              "flex": 0,
              "components": [
                {
                  "id": "btn-create",
                  "type": "button",
                  "propertyName": "btnCreate",
                  "label": "Schedule Interview",
                  "editMode": "editable",
                  "buttonType": "primary",
                  "actionConfiguration": {
                    "actionName": "Navigate",
                    "actionOwner": "shesha.common",
                    "configData": {
                      "target": "/dynamic/A.Test/erecruitment-interview-details"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "dt-ctx",
          "type": "datatableContext",
          "propertyName": "dtCtx",
          "label": "Interviews Context",
          "sourceType": "Entity",
          "entityType": "A.Test.Domain.Domain.Recruitment.Interview",
          "components": [
            {
              "id": "search-row",
              "type": "columns",
              "propertyName": "searchRow",
              "label": "",
              "columns": [
                {
                  "id": "col-qs",
                  "flex": 1,
                  "components": [
                    {
                      "id": "quick-search",
                      "type": "datatable.quickSearch",
                      "propertyName": "quickSearch",
                      "label": "Search",
                      "editMode": "editable",
                      "placeholder": "Search interviews..."
                    }
                  ]
                }
              ]
            },
            {
              "id": "interviews-table",
              "type": "datatable",
              "propertyName": "interviewsTable",
              "label": "Interviews",
              "useMultiselect": false,
              "rowSelectionMode": "none",
              "onRowDoubleClick": {
                "actionName": "Navigate",
                "actionOwner": "shesha.common",
                "configData": {
                  "target": "/dynamic/A.Test/erecruitment-interview-details?id={{selectedRow.Id}}"
                }
              },
              "columns": [
                {
                  "id": "col-application",
                  "columnType": "data",
                  "propertyName": "JobApplication",
                  "caption": "Application",
                  "minWidth": 180
                },
                {
                  "id": "col-date",
                  "columnType": "data",
                  "propertyName": "InterviewDate",
                  "caption": "Interview Date",
                  "minWidth": 140
                },
                {
                  "id": "col-venue",
                  "columnType": "data",
                  "propertyName": "Venue",
                  "caption": "Venue",
                  "minWidth": 180
                },
                {
                  "id": "col-type",
                  "columnType": "data",
                  "propertyName": "InterviewType",
                  "caption": "Type",
                  "minWidth": 100
                },
                {
                  "id": "col-panel",
                  "columnType": "data",
                  "propertyName": "InterviewPanel",
                  "caption": "Panel",
                  "minWidth": 200
                },
                {
                  "id": "col-outcome",
                  "columnType": "data",
                  "propertyName": "Outcome",
                  "caption": "Outcome",
                  "minWidth": 100
                },
                {
                  "id": "col-actions",
                  "columnType": "action",
                  "caption": "Edit",
                  "minWidth": 80,
                  "icon": "EditOutlined",
                  "actionConfiguration": {
                    "actionName": "Navigate",
                    "actionOwner": "shesha.common",
                    "configData": {
                      "target": "/dynamic/A.Test/erecruitment-interview-details?id={{currentRow.Id}}"
                    }
                  }
                }
              ]
            },
            {
              "id": "pager",
              "type": "datatable.pager",
              "propertyName": "pager",
              "label": "Pager",
              "defaultPageSize": 20,
              "showSizeChanger": true,
              "showTotal": true
            }
          ]
        }
      ]
    }
  ],
  "formSettings": {
    "layout": "horizontal",
    "colon": false,
    "labelCol": { "span": 6 },
    "wrapperCol": { "span": 18 }
  }
}
