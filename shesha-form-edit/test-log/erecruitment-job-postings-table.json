{
  "components": [
    {
      "id": "root-container",
      "type": "container",
      "propertyName": "root",
      "label": "",
      "hidden": false,
      "components": [
        {
          "id": "toolbar-row",
          "type": "columns",
          "propertyName": "toolbarRow",
          "label": "",
          "hidden": false,
          "columns": [
            {
              "id": "col-title",
              "flex": 1,
              "components": [
                {
                  "id": "page-title",
                  "type": "text",
                  "propertyName": "pageTitle",
                  "content": "Job Postings",
                  "fontSize": 24,
                  "fontWeight": "bold",
                  "color": "#1a1a1a"
                }
              ]
            },
            {
              "id": "col-btn",
              "flex": 0,
              "components": [
                {
                  "id": "btn-create",
                  "type": "button",
                  "propertyName": "btnCreate",
                  "label": "Post New Job",
                  "editMode": "editable",
                  "buttonType": "primary",
                  "actionConfiguration": {
                    "actionName": "Navigate",
                    "actionOwner": "shesha.common",
                    "configData": {
                      "target": "/dynamic/A.Test/erecruitment-job-posting-details"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "dt-ctx",
          "type": "datatableContext",
          "propertyName": "dtCtx",
          "label": "Job Postings Context",
          "sourceType": "Entity",
          "entityType": "A.Test.Domain.Domain.Recruitment.JobPosting",
          "components": [
            {
              "id": "dt-search-row",
              "type": "columns",
              "propertyName": "dtSearchRow",
              "label": "",
              "columns": [
                {
                  "id": "col-qs",
                  "flex": 1,
                  "components": [
                    {
                      "id": "quick-search",
                      "type": "datatable.quickSearch",
                      "propertyName": "quickSearch",
                      "label": "Search",
                      "editMode": "editable",
                      "placeholder": "Search job postings..."
                    }
                  ]
                }
              ]
            },
            {
              "id": "job-postings-table",
              "type": "datatable",
              "propertyName": "jobPostingsTable",
              "label": "Job Postings",
              "useMultiselect": false,
              "rowSelectionMode": "none",
              "onRowDoubleClick": {
                "actionName": "Navigate",
                "actionOwner": "shesha.common",
                "configData": {
                  "target": "/dynamic/A.Test/erecruitment-job-posting-details?id={{selectedRow.Id}}"
                }
              },
              "columns": [
                {
                  "id": "col-title",
                  "columnType": "data",
                  "propertyName": "JobTitle",
                  "caption": "Job Title",
                  "minWidth": 200
                },
                {
                  "id": "col-ref",
                  "columnType": "data",
                  "propertyName": "Reference",
                  "caption": "Reference",
                  "minWidth": 100
                },
                {
                  "id": "col-department",
                  "columnType": "data",
                  "propertyName": "Department",
                  "caption": "Department",
                  "minWidth": 150
                },
                {
                  "id": "col-location",
                  "columnType": "data",
                  "propertyName": "Location",
                  "caption": "Location",
                  "minWidth": 120
                },
                {
                  "id": "col-closing",
                  "columnType": "data",
                  "propertyName": "ClosingDate",
                  "caption": "Closing Date",
                  "minWidth": 130
                },
                {
                  "id": "col-status",
                  "columnType": "data",
                  "propertyName": "Status",
                  "caption": "Status",
                  "minWidth": 100
                },
                {
                  "id": "col-actions",
                  "columnType": "action",
                  "caption": "Actions",
                  "minWidth": 120,
                  "icon": "EditOutlined",
                  "actionConfiguration": {
                    "actionName": "Navigate",
                    "actionOwner": "shesha.common",
                    "configData": {
                      "target": "/dynamic/A.Test/erecruitment-job-posting-details?id={{currentRow.Id}}"
                    }
                  }
                }
              ]
            },
            {
              "id": "pager",
              "type": "datatable.pager",
              "propertyName": "pager",
              "label": "Pager",
              "defaultPageSize": 20,
              "showSizeChanger": true,
              "showTotal": true
            }
          ]
        }
      ]
    }
  ],
  "formSettings": {
    "layout": "horizontal",
    "colon": false,
    "labelCol": { "span": 6 },
    "wrapperCol": { "span": 18 }
  }
}
